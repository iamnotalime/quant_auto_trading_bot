# Root-controlled, nonsecret signed deployment/evidence policy for systemd.
# Install as /opt/quant-auto-trader/deployment/governance.env owned by
# root:quantbot with mode 0640. The quantbot service account must never be able to
# replace this file or any referenced signed artifact.

DEPLOYMENT_APPROVAL_PATH=/opt/quant-auto-trader/deployment/deployment-approval.json
DEPLOYMENT_GOVERNANCE_PUBLIC_KEYS_PATH=/opt/quant-auto-trader/deployment/deployment-keys.json
DEPLOYMENT_GOVERNANCE_PUBLIC_KEYS_SHA256=<independently-pinned-lowercase-sha256>

COVARIANCE_EVIDENCE_PATH=/opt/quant-auto-trader/deployment/covariance-envelope.json
COVARIANCE_EXECUTION_PRICES_PATH=/opt/quant-auto-trader/deployment/execution-window-vwap.csv
COVARIANCE_CORPORATE_ACTIONS_PATH=/opt/quant-auto-trader/deployment/corporate-actions.csv
COVARIANCE_GOVERNANCE_PUBLIC_KEYS_PATH=/opt/quant-auto-trader/deployment/covariance-keys.json
COVARIANCE_GOVERNANCE_PUBLIC_KEYS_SHA256=<independently-pinned-lowercase-sha256>
COVARIANCE_PROVIDER_ID=<signed-provider-identity>
COVARIANCE_VENUE_ID=<signed-execution-venue-identity>

BORROW_EVIDENCE_PATH=/opt/quant-auto-trader/deployment/borrow-envelope.json
BORROW_TERMS_PATH=/opt/quant-auto-trader/deployment/borrow-terms.csv
BORROW_GOVERNANCE_PUBLIC_KEYS_PATH=/opt/quant-auto-trader/deployment/borrow-keys.json
BORROW_GOVERNANCE_PUBLIC_KEYS_SHA256=<independently-pinned-lowercase-sha256>
BORROW_PROVIDER_ID=<signed-borrow-provider-identity>
BORROW_VENUE_ID=<signed-locate-venue-identity>
BORROW_MAX_TERM_AGE_SECONDS=300
MAX_LIVE_ANNUAL_BORROW_RATE=0.02
