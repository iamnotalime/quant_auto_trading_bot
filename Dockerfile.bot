# Pin both the Python patch line and immutable Docker Official Image manifest.
# Update this digest only through a reviewed dependency change.
FROM python:3.14.8-slim@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=0 \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1

WORKDIR /app
COPY requirements.lock ./
RUN python -m pip install --no-cache-dir --require-hashes -r requirements.lock
COPY . .
RUN useradd --create-home --uid 10001 quantbot \
    && mkdir -p /app/runtime /app/state /app/control /app/emergency \
    && chown -R quantbot:quantbot /app
USER quantbot

HEALTHCHECK --interval=60s --timeout=15s --start-period=30s --retries=3 \
    CMD python bot.py status --healthcheck >/dev/null || exit 1

CMD ["python", "bot.py", "daemon"]
