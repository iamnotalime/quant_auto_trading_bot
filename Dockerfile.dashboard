# Pin both the Python patch line and immutable Docker Official Image manifest.
# Update this digest only through a reviewed dependency change.
FROM python:3.14.0-slim@sha256:0aecac02dc3d4c5dbb024b753af084cafe41f5416e02193f1ce345d671ec966e

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=0 \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1

WORKDIR /app
COPY requirements.lock ./
RUN python -m pip install --no-cache-dir --require-hashes -r requirements.lock
COPY . .
RUN useradd --create-home --uid 10001 quantbot \
    && mkdir -p /app/runtime /app/state /app/control \
    && chown -R quantbot:quantbot /app
USER quantbot
EXPOSE 8502
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8502/_stcore/health', timeout=5)" || exit 1
CMD ["streamlit", "run", "bot_dashboard.py", "--server.address=0.0.0.0", "--server.port=8502", "--server.headless=true"]
