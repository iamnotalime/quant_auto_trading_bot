# -----------------------------------------------------------------------------
# SAFE DEFAULT: offline simulation and plan-only mode.
# Copy this file to .env and change one setting at a time.
# -----------------------------------------------------------------------------
BROKER=simulated
EXECUTION_ENABLED=false

# Alpaca configuration. Used only when BROKER=alpaca.
ALPACA_PAPER=true
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Independent account pin checked against the authenticated broker connection before
# state is opened or any routine/emergency broker mutation is attempted.
ALPACA_ACCOUNT_ID=
ALPACA_DATA_FEED=iex

# Secret 256-bit key for plan HMACs and authenticated risk-state rows. Generate once
# with: python -c "import secrets; print(secrets.token_hex(32))"
# Required for every Alpaca mode, including plan-only. Never commit, log, or rotate this
# key while its state database is active; only its SHA-256 fingerprint enters approvals.
PLAN_AUTHENTICATION_KEY=

# Separate 256-bit HMAC key for the SQLite-independent emergency order journal.
# Generate it independently from PLAN_AUTHENTICATION_KEY. Required in every Alpaca
# mode, including minimal `bot.py kill` recovery; never derive it from broker secrets.
EMERGENCY_AUTHENTICATION_KEY=
EMERGENCY_JOURNAL_PATH=runtime/EMERGENCY_JOURNAL.json

# Live order submission requires all five settings below plus the signed deployment
# approval and pinned deployment key registry configured in the next section.
#   BROKER=alpaca
#   ALPACA_PAPER=false
#   EXECUTION_ENABLED=true
#   DEDICATED_ACCOUNT=true
# plus the exact acknowledgement below.
LIVE_TRADING_ACK=
# LIVE_TRADING_ACK=I_UNDERSTAND_LIVE_TRADING_CAN_LOSE_MONEY

# Every Alpaca order-enabled process (paper or live) requires an unexpired RSA/SHA-256
# v2 deployment approval (maximum lifetime: seven days). It binds the complete AppConfig,
# all non-secret daemon policy, exact source/dependency hashes, research runtime identity,
# deployment-descriptor hashes, pinned container base-image digest, passed sealed-
# certification evidence, broker mode, and authoritative Alpaca account ID. When this
# path is set, the approval's complete strategy_config replaces all partial strategy
# environment overrides.
# For Docker Compose use /app/deployment/... and place the files in
# DEPLOYMENT_GOVERNANCE_HOST_DIR (default: ./runtime/governance).
# For systemd, do not use writable runtime paths. Install the separate
# deploy/governance.env.example as root:quantbot mode 0640 under
# /opt/quant-auto-trader/deployment and use its absolute paths.
DEPLOYMENT_APPROVAL_PATH=
DEPLOYMENT_GOVERNANCE_PUBLIC_KEYS_PATH=
DEPLOYMENT_GOVERNANCE_HOST_DIR=./runtime/governance
DEPLOYMENT_GOVERNANCE_PUBLIC_KEYS_SHA256=

# Governed Alpaca planning never substitutes adjusted daily closes for the sealed
# 09:30-09:35 execution-risk model. Configure all seven values together. The signed
# envelope authenticates the exact wide VWAP CSV, complete long-form split/cash/as-of
# CSV, provider/venue identities, universe, cutoff, and expiry. For Compose, put all
# files below DEPLOYMENT_GOVERNANCE_HOST_DIR; that directory is mounted read-only.
COVARIANCE_EVIDENCE_PATH=
COVARIANCE_EXECUTION_PRICES_PATH=
COVARIANCE_CORPORATE_ACTIONS_PATH=
COVARIANCE_GOVERNANCE_PUBLIC_KEYS_PATH=
COVARIANCE_GOVERNANCE_PUBLIC_KEYS_SHA256=
COVARIANCE_PROVIDER_ID=
COVARIANCE_VENUE_ID=

# Every order-enabled Alpaca process also requires an exact-session, account-bound
# signed live-borrow snapshot. Configure all six trust values together. The terms CSV
# must contain one explicit availability/located-quantity/rate/recall row for every symbol,
# observed no later than 09:30 New York and no more than the configured age before each
# authorization check. For Compose, use /app/deployment/... paths and publish the terms
# file before atomically publishing its signed envelope.
BORROW_EVIDENCE_PATH=
BORROW_TERMS_PATH=
BORROW_GOVERNANCE_PUBLIC_KEYS_PATH=
BORROW_GOVERNANCE_PUBLIC_KEYS_SHA256=
BORROW_PROVIDER_ID=
BORROW_VENUE_ID=
# The verifier permits 1-300 seconds; the age window never permits an observation after 09:30.
BORROW_MAX_TERM_AGE_SECONDS=300
# This deployment ceiling may not exceed the signed strategy's
# ANNUAL_SHORT_BORROW_RATE. A higher live rate requires a newly sealed, more
# conservative research assumption and a new deployment approval.
MAX_LIVE_ANNUAL_BORROW_RATE=0.02

# Replace with a point-in-time, liquid, shortable universe. These ETF symbols are
# examples for connectivity testing, not recommendations.
SYMBOLS=SPY,QQQ,IWM,DIA,XLK,XLF,XLE,XLV,XLI,XLY,XLP,XLU,XLB,XLRE,TLT,IEF,GLD,SLV,DBC,USO
STRATEGY_TIMEZONE=America/New_York

# Completed-close plan after the session. Governed execution is permitted only on the
# envelope's signed next session, from 09:30 inclusive until the 09:35 exclusive hard
# deadline; no routine child starts or retries at/after 09:35.
PLAN_TIME=16:15
EXECUTION_TIME=09:30
EXECUTION_WINDOW_MINUTES=5
POLL_SECONDS=60
SCHEDULER_RETRY_MINUTES=5
# Must be at least 253 so the signed evidence retains the boundary observation while
# the shared research/live EWMA consumes its trailing 252 price points / 251 returns.
HISTORY_BARS=420
MINIMUM_ASSETS=20
MAX_DATA_AGE_DAYS=5
# Exploratory/simulated compatibility only. Governed Alpaca ignores age tolerance and
# requires the exact authenticated next exchange session.
MAX_PLAN_AGE_DAYS=5

# Conservative live defaults. Do not raise leverage to force a historical return target.
TARGET_VOLATILITY=0.08
MAX_GROSS_LEVERAGE=1.50
MAX_POSITION_WEIGHT=0.08
ALLOW_SHORTING=true
REQUIRE_EASY_TO_BORROW=true
WHOLE_SHARES_ONLY=true
MIN_TRADE_NOTIONAL=100
MAX_SINGLE_ORDER_NOTIONAL_PCT=0.08
BUYING_POWER_BUFFER=0.10
MAX_ORDERS_PER_CYCLE=50
RESIDUAL_NOTIONAL_TOLERANCE=250
# Independent broker-position monitor tolerances. Breaches persist a halt and flatten
# the dedicated account rather than waiting for a P&L loss trigger.
ACTUAL_GROSS_EXPOSURE_TOLERANCE=0.05
ACTUAL_NET_EXPOSURE_LIMIT=0.07
ACTUAL_BETA_EXPOSURE_LIMIT=0.10
ACTUAL_POSITION_WEIGHT_TOLERANCE=0.02

# Risk shutdowns. Flattening begins before the stated 15% hard breach.
FLATTEN_DRAWDOWN=0.12
HARD_DRAWDOWN_LIMIT=0.15
DAILY_LOSS_TRIGGER=0.02
FIVE_DAY_LOSS_TRIGGER=0.04
COOLDOWN_SESSIONS=20
FLATTEN_ON_DAILY_LOSS=true
FLATTEN_ON_FIVE_DAY_LOSS=true
FLATTEN_ON_EXECUTION_ERROR=true
AUTO_RESUME_AFTER_COOLDOWN=false

# Execution assumptions and operational files.
TRANSACTION_COST_BPS=3.0
ANNUAL_SHORT_BORROW_RATE=0.02
ANNUAL_FINANCING_RATE=0.04
ORDER_FILL_TIMEOUT_SECONDS=90
ORDER_POLL_SECONDS=2
MAX_EXECUTION_PRICE_AGE_SECONDS=60
MAX_EXECUTION_SPREAD_BPS=50
# Routine Alpaca orders are marketable limits no worse than this distance from
# the current, freshness/spread-validated quote midpoint. Emergency flattening
# deliberately uses uncapped market orders so an obsolete limit cannot trap risk.
MARKETABLE_LIMIT_COLLAR_BPS=35
DATABASE_PATH=runtime/auto_trader.sqlite3
LOG_PATH=runtime/auto_trader.log
KILL_SWITCH_PATH=runtime/KILL_SWITCH
PROCESS_LOCK_PATH=runtime/auto_trader.lock
OPERATION_LOCK_PATH=runtime/auto_trader.operation.lock
KILL_SWITCH_ACK_PATH=runtime/KILL_SWITCH.ack.json
DAEMON_HEALTH_PATH=runtime/daemon_health.json
OPERATION_LOCK_TIMEOUT_SECONDS=30
HEALTH_FAILURE_THRESHOLD=3
# Reaching this count creates the durable kill marker, attempts emergency
# reconciliation, and exits non-zero so Docker/systemd restarts the daemon.
DAEMON_WATCHDOG_TIMEOUT_SECONDS=900
# A stalled main loop creates a kill marker and exits immediately. Verified broker
# polling feeds the watchdog; keep this above 3 * ORDER_FILL_TIMEOUT_SECONDS +
# POLL_SECONDS + 60.
DEDICATED_ACCOUNT=false

# The operations dashboard is bound to localhost by Docker Compose. Its emergency
# control remains disabled unless this is set to a long, random, unique secret.
# Generate and store it like any other operational credential; do not commit it.
DASHBOARD_CONTROL_TOKEN=

# Separate tamper-evident research experiment ledger.
RESEARCH_LEDGER_PATH=runtime/research_trials.sqlite3
# Sealed validation remains unavailable unless an externally governed RSA/SHA-256
# public-key registry is configured and its exact file hash is pinned here. Exploratory
# research does not require these settings.
# Local non-container runs may set this to runtime/governance/trusted_public_keys.json.
# Compose overrides the in-container path and mounts this host directory read-only.
RESEARCH_GOVERNANCE_PUBLIC_KEYS_PATH=
RESEARCH_GOVERNANCE_PUBLIC_KEYS_HOST_DIR=./runtime/governance
RESEARCH_GOVERNANCE_PUBLIC_KEYS_SHA256=

# Offline simulator settings.
SIMULATED_PRICES_PATH=sample_prices.csv
SIMULATED_STATE_PATH=runtime/simulated_broker.json
SIMULATED_STARTING_CASH=100000
SIMULATED_MARKET_ALWAYS_OPEN=true
SIMULATED_SLIPPAGE_BPS=2.0
